#!/usr/bin/python3
# omarchy:summary=Print the Pi coding agent usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Pi coding agent usage into one display-ready JSON record.

Local stats come from ~/.pi/agent/sessions/ JSONL session databases;
model definitions and context window limits come from ~/.pi/agent/models.json
and ~/.pi/agent/settings.json.
"""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import glob
import hashlib
import json
import os
import sys
import tempfile
import time
from pathlib import Path
from typing import Any

AGENT_ID = "pi"
AGENT_NAME = "Pi"
AUTH_HELP = "Run `pi` to start a session."

SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def pi_agent_dir() -> Path:
  return Path(os.environ.get("PI_AGENT_DIR") or (Path.home() / ".pi" / "agent"))


def date_string(value: dt.date) -> str:
  return value.strftime("%Y-%m-%d")


def recent_date_strings() -> list[str]:
  today = dt.datetime.now().date()
  return [date_string(today - dt.timedelta(days=offset)) for offset in range(6, -1, -1)]


def local_date_string() -> str:
  return date_string(dt.datetime.now().date())


def load_models_metadata(base_dir: Path) -> dict[str, dict[str, Any]]:
  """Load model context windows and configurations from models.json."""
  models_map: dict[str, dict[str, Any]] = {}
  models_file = base_dir / "models.json"
  if not models_file.exists():
    return models_map

  try:
    with models_file.open("r", encoding="utf-8") as f:
      data = json.load(f)
      providers = data.get("providers", {})
      for prov_name, prov_data in providers.items():
        if not isinstance(prov_data, dict):
          continue
        models_list = prov_data.get("models", [])
        for m in models_list:
          if isinstance(m, dict) and "id" in m:
            m_id = m["id"]
            models_map[m_id] = {
              "name": m.get("name", m_id),
              "contextWindow": m.get("contextWindow", 65536),
              "maxTokens": m.get("maxTokens", 8192),
              "provider": prov_name,
            }
  except Exception:
    pass

  return models_map


def scan_pi_sessions(base_dir: Path) -> tuple[dict[str, Any], dict[str, Any]]:
  sessions_glob = str(base_dir / "sessions" / "*" / "*.jsonl")
  session_files = glob.glob(sessions_glob)

  today = local_date_string()
  recent_dates = recent_date_strings()
  recent = {day: {"date": day, "messageCount": 0} for day in recent_dates}
  today_tokens_by_model: dict[str, int] = {}
  model_usage: dict[str, dict[str, int]] = {}
  today_sessions: set[str] = set()
  total_sessions: set[str] = set()
  active_days: set[str] = set()
  today_prompts = 0
  today_total_tokens = 0
  total_prompts = 0

  latest_turn_time = 0.0
  latest_model = "qwen-27b"
  latest_input_tokens = 0

  models_meta = load_models_metadata(base_dir)

  for file_str in session_files:
    file_path = Path(file_str)
    session_id = file_path.stem
    total_sessions.add(session_id)
    try:
      mtime = file_path.stat().st_mtime
    except Exception:
      mtime = time.time()

    current_session_model = "qwen-27b"

    try:
      with file_path.open("r", encoding="utf-8", errors="replace") as f:
        for line in f:
          line = line.strip()
          if not line:
            continue
          try:
            entry = json.loads(line)
          except Exception:
            continue

          etype = entry.get("type")
          ts_str = entry.get("timestamp")
          entry_ts = mtime
          if ts_str:
            try:
              dt_obj = dt.datetime.fromisoformat(ts_str.replace("Z", "+00:00"))
              entry_ts = dt_obj.timestamp()
            except Exception:
              pass

          day = dt.datetime.fromtimestamp(entry_ts).strftime("%Y-%m-%d")

          if etype == "model_change":
            m_id = entry.get("modelId")
            if m_id:
              current_session_model = m_id
          elif etype == "message":
            msg = entry.get("message") or {}
            role = msg.get("role")
            if role == "user":
              total_prompts += 1
              active_days.add(day)
              if day == today:
                today_prompts += 1
                today_sessions.add(session_id)
            elif role == "assistant":
              model = msg.get("model") or current_session_model
              usage = msg.get("usage") or {}
              inp = int(usage.get("input") or 0)
              out = int(usage.get("output") or 0)
              cread = int(usage.get("cacheRead") or 0)
              cwrite = int(usage.get("cacheWrite") or 0)
              reason = int(usage.get("reasoning") or 0)
              total_turn_tokens = int(usage.get("totalTokens") or (inp + out + cread + cwrite))

              active_days.add(day)

              if entry_ts > latest_turn_time:
                latest_turn_time = entry_ts
                latest_model = model
                latest_input_tokens = inp

              bucket = model_usage.setdefault(
                model,
                {
                  "inputTokens": 0,
                  "outputTokens": 0,
                  "cacheReadInputTokens": 0,
                  "cacheCreationInputTokens": 0,
                },
              )
              bucket["inputTokens"] += inp
              bucket["outputTokens"] += out
              bucket["cacheReadInputTokens"] += cread
              bucket["cacheCreationInputTokens"] += cwrite

              if day in recent:
                recent[day]["messageCount"] += total_turn_tokens

              if day == today:
                today_sessions.add(session_id)
                today_total_tokens += total_turn_tokens
                today_tokens_by_model[model] = today_tokens_by_model.get(model, 0) + total_turn_tokens
    except Exception:
      continue

  # Load default model from settings.json if no sessions ran yet
  if not latest_model:
    settings_file = base_dir / "settings.json"
    if settings_file.exists():
      try:
        with settings_file.open("r", encoding="utf-8") as f:
          sdata = json.load(f)
          latest_model = sdata.get("defaultModel", "qwen-27b")
      except Exception:
        latest_model = "qwen-27b"

  stats = {
    "todayPrompts": today_prompts,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_total_tokens,
    "todayTokensByModel": today_tokens_by_model,
    "recentDays": [recent[d] for d in recent_dates],
    "totalPrompts": total_prompts,
    "totalSessions": len(total_sessions),
    "activeDays": len(active_days),
    "activeDates": sorted(active_days),
    "modelUsage": model_usage,
  }

  runtime = {
    "latest_model": latest_model,
    "latest_input_tokens": latest_input_tokens,
    "models_meta": models_meta,
  }

  return stats, runtime


def read_fresh_json(path: Path, max_age_seconds: float) -> dict[str, Any] | None:
  if max_age_seconds <= 0 or not path.exists():
    return None
  try:
    age = time.time() - path.stat().st_mtime
    if 0 <= age <= max_age_seconds:
      return json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return None
  return None


def write_json(path: Path, payload: dict[str, Any]) -> None:
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":")) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def cached_stats(max_age: float) -> tuple[dict[str, Any], dict[str, Any]]:
  base = pi_agent_dir()
  digest = hashlib.sha1(str(base).encode("utf-8")).hexdigest()[:16]
  root = cache_root()
  cache_file = root / f"pi-scan-{digest}.json"
  lock_file = root / f"pi-scan-{digest}.lock"

  if max_age > 0:
    cached = read_fresh_json(cache_file, max_age)
    if cached and cached.get("schemaVersion") == 1 and cached.get("scanDate") == local_date_string():
      stats = cached.get("stats")
      runtime = cached.get("runtime")
      if isinstance(stats, dict) and isinstance(runtime, dict):
        return stats, runtime

  try:
    with lock_file.open("w") as lock:
      fcntl.flock(lock, fcntl.LOCK_EX)
      if max_age > 0:
        cached = read_fresh_json(cache_file, max_age)
        if cached and cached.get("schemaVersion") == 1 and cached.get("scanDate") == local_date_string():
          stats = cached.get("stats")
          runtime = cached.get("runtime")
          if isinstance(stats, dict) and isinstance(runtime, dict):
            return stats, runtime
      stats, runtime = scan_pi_sessions(base)
      write_json(cache_file, {"schemaVersion": 1, "scanDate": local_date_string(), "stats": stats, "runtime": runtime})
      return stats, runtime
  except Exception:
    return scan_pi_sessions(base)


def build_limits(runtime: dict[str, Any]) -> list[dict[str, Any]]:
  limits = []
  latest_model = runtime.get("latest_model", "qwen-27b")
  latest_input_tokens = runtime.get("latest_input_tokens", 0)
  models_meta = runtime.get("models_meta", {})

  meta = models_meta.get(latest_model) or {}
  ctx_max = meta.get("contextWindow", 65536)

  if ctx_max > 0 and latest_input_tokens > 0:
    pct = min(1.0, max(0.0, float(latest_input_tokens) / float(ctx_max)))
    label_k = f"{ctx_max // 1000}k" if ctx_max >= 1000 else str(ctx_max)
    used_k = f"{latest_input_tokens // 1000}k" if latest_input_tokens >= 1000 else str(latest_input_tokens)
    limits.append({
      "label": f"Context ({label_k})",
      "title": "Context",
      "percent": round(pct, 4),
      "resetsAt": "",
      "detail": f"{used_k} / {label_k} tokens ({round(pct * 100, 1)}%)",
    })
  return limits


def format_tier_label(model_id: str, models_meta: dict[str, Any]) -> str:
  meta = models_meta.get(model_id) or {}
  name = meta.get("name")
  if name:
    # Shorten long marketing names for bar/panel tier label
    clean = name.split("(")[0].strip()
    return clean
  return model_id.split("/")[-1].replace("-", " ").title()


def main() -> int:
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true", help="rescan sessions and ignore cache")
  parser.add_argument("--limits-only", action="store_true", help="reuse recent scans")
  parser.add_argument("--cache-seconds", type=float, default=SCAN_REUSE_SECONDS)
  args = parser.parse_args()

  max_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else args.cache_seconds)
  stats, runtime = cached_stats(max_age)
  limits: list[dict[str, Any]] = []

  latest_model = runtime.get("latest_model", "qwen-27b")
  models_meta = runtime.get("models_meta", {})
  tier_label = format_tier_label(latest_model, models_meta)

  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "tierLabel": tier_label,
    "ready": stats["totalPrompts"] > 0 or len(limits) > 0,
    "hasLocalStats": True,
    "usageStatusText": "",
    "authHelpText": AUTH_HELP,
    "limits": limits,
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
  }
  record.update(stats)

  print(json.dumps(record, separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
