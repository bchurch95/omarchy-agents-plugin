#!/usr/bin/python3
# omarchy:summary=Print the Google Antigravity usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Google Antigravity usage into one display-ready JSON record.

Local stats come from ~/.gemini/antigravity-cli conversation databases,
protobuf step and generation records, and transcripts; context limits
and quota details come from active session metadata.
"""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import glob
import hashlib
import json
import os
import sqlite3
import sys
import tempfile
import time
from pathlib import Path
from typing import Any

AGENT_ID = "antigravity"
AGENT_NAME = "Antigravity"
AUTH_HELP = "Run `agy` to start a session."

SCAN_REUSE_SECONDS = 5
LIMITS_ONLY_REUSE_SECONDS = 15


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def gemini_dir() -> Path:
  return Path(os.environ.get("ANTIGRAVITY_APP_DATA_DIR") or (Path.home() / ".gemini" / "antigravity-cli"))


def date_string(value: dt.date) -> str:
  return value.strftime("%Y-%m-%d")


def recent_date_strings() -> list[str]:
  today = dt.datetime.now().date()
  return [date_string(today - dt.timedelta(days=offset)) for offset in range(6, -1, -1)]


def local_date_string() -> str:
  return date_string(dt.datetime.now().date())


def parse_proto(data: bytes) -> list[tuple[int, str, Any]]:
  """Decode raw protobuf bytes into a list of (field_number, wire_type, value)."""
  fields = []
  idx = 0
  length = len(data)
  while idx < length:
    try:
      key = 0
      shift = 0
      while True:
        b = data[idx]
        idx += 1
        key |= (b & 0x7F) << shift
        shift += 7
        if not (b & 0x80):
          break
      fn = key >> 3
      wt = key & 0x7
      if wt == 0:  # varint
        val = 0
        shift = 0
        while True:
          b = data[idx]
          idx += 1
          val |= (b & 0x7F) << shift
          shift += 7
          if not (b & 0x80):
            break
        fields.append((fn, "varint", val))
      elif wt == 2:  # length-delimited
        l = 0
        shift = 0
        while True:
          b = data[idx]
          idx += 1
          l |= (b & 0x7F) << shift
          shift += 7
          if not (b & 0x80):
            break
        val = data[idx : idx + l]
        idx += l
        fields.append((fn, "bytes", val))
      elif wt == 1:  # 64-bit
        fields.append((fn, "64bit", data[idx : idx + 8]))
        idx += 8
      elif wt == 5:  # 32-bit
        fields.append((fn, "32bit", data[idx : idx + 4]))
        idx += 4
      else:
        break
    except Exception:
      break
  return fields


def get_step_timestamp(step_meta: bytes | None) -> float | None:
  if not step_meta:
    return None
  try:
    fields = parse_proto(step_meta)
    for fn, t, v in fields:
      if fn == 1 and t == "bytes":  # Timestamp proto
        sub = parse_proto(v)
        sec = 0
        nanos = 0
        for sfn, st, sv in sub:
          if sfn == 1 and st == "varint":
            sec = sv
          elif sfn == 2 and st == "varint":
            nanos = sv
        if sec > 0:
          return sec + (nanos / 1e9)
  except Exception:
    pass
  return None


def extract_gen_info(blob: bytes) -> tuple[str, dict[int, int], int | None, dict[str, Any]]:
  """Extract model, token stats, last_step_index, and context window from GenerationMetadata."""
  model = "gemini-3.7-flash"
  token_stats: dict[int, int] = {}
  last_step_index: int | None = None
  quota_info: dict[str, Any] = {}

  try:
    top_fields = parse_proto(blob)
    for fn, ftype, fval in top_fields:
      if fn == 1 and ftype == "bytes":  # GenerationMetadata
        gen_fields = parse_proto(fval)
        for gfn, gftype, gfval in gen_fields:
          if gfn == 19 and gftype == "bytes":
            try:
              model = gfval.decode("utf-8")
            except Exception:
              pass
          elif gfn == 4 and gftype == "bytes":
            stat_fields = parse_proto(gfval)
            for sfn, sftype, sfval in stat_fields:
              if sftype == "varint":
                token_stats[sfn] = sfval
          elif gfn == 9 and gftype == "bytes":
            # Context window & quota info
            qfields = parse_proto(gfval)
            for qfn, qftype, qfval in qfields:
              if qfn == 10 and qftype == "bytes":
                ctx_fields = parse_proto(qfval)
                curr_ctx = 0
                max_ctx = 0
                for cfn, cftype, cfval in ctx_fields:
                  if cfn == 1 and cftype == "varint":
                    curr_ctx = cfval
                  elif cfn == 4 and cftype == "varint":
                    max_ctx = cfval
                if max_ctx > 0:
                  quota_info["context_used"] = curr_ctx
                  quota_info["context_max"] = max_ctx
          elif gfn == 20 and gftype == "bytes":
            meta_fields = parse_proto(gfval)
            k = None
            v = None
            for mfn, mftype, mfval in meta_fields:
              if mfn == 1 and mftype == "bytes":
                try:
                  k = mfval.decode("utf-8")
                except Exception:
                  pass
              elif mfn == 2 and mftype == "bytes":
                try:
                  v = mfval.decode("utf-8")
                except Exception:
                  pass
            if k == "last_step_index" and v is not None:
              try:
                last_step_index = int(v)
              except Exception:
                pass
  except Exception:
    pass

  return model, token_stats, last_step_index, quota_info


def scan_sqlite_conversations(base_dir: Path) -> tuple[dict[str, Any], dict[str, Any]]:
  conv_dbs = glob.glob(str(base_dir / "conversations" / "*.db"))

  today = local_date_string()
  recent_dates = recent_date_strings()
  recent = {day: {"date": day, "messageCount": 0} for day in recent_dates}
  today_tokens_by_model: dict[str, int] = {}
  model_usage: dict[str, dict[str, int]] = {}
  today_sessions: set[str] = set()
  total_sessions: set[str] = set()
  active_days: set[str] = set()
  today_prompts = 0
  today_total_tokens = 0
  total_prompts = 0

  latest_turn_time = 0.0
  latest_quota_info: dict[str, Any] = {}
  latest_model = "gemini-3.7-flash"

  for db_str in conv_dbs:
    if db_str.endswith("-wal") or db_str.endswith("-shm"):
      continue
    db_path = Path(db_str)
    session_id = db_path.stem
    total_sessions.add(session_id)
    try:
      mtime = db_path.stat().st_mtime
    except Exception:
      mtime = time.time()

    try:
      conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=2.0)
      conn.execute("PRAGMA query_only = ON;")
      cur = conn.cursor()

      step_times: dict[int, float] = {}
      try:
        cur.execute("SELECT idx, step_type, metadata FROM steps;")
        for idx, stype, meta in cur.fetchall():
          ts = get_step_timestamp(meta)
          if ts:
            step_times[idx] = ts
            day = dt.datetime.fromtimestamp(ts).strftime("%Y-%m-%d")
          else:
            day = dt.datetime.fromtimestamp(mtime).strftime("%Y-%m-%d")

          if stype == 14:  # USER_INPUT
            total_prompts += 1
            active_days.add(day)
            if day == today:
              today_prompts += 1
              today_sessions.add(session_id)
      except Exception:
        pass

      try:
        cur.execute("SELECT rowid, data FROM gen_metadata;")
        for rowid, data in cur.fetchall():
          model, stats, lsi, quota_info = extract_gen_info(data)
          ts = step_times.get(lsi, mtime) if lsi is not None else mtime
          day = dt.datetime.fromtimestamp(ts).strftime("%Y-%m-%d")
          active_days.add(day)

          if ts > latest_turn_time:
            latest_turn_time = ts
            latest_model = model
            if quota_info:
              latest_quota_info = quota_info

          input_tokens = stats.get(2, 0)
          output_tokens = stats.get(3, 0)
          cache_read = stats.get(5, 0)
          cache_write = 0
          total_turn_tokens = input_tokens + output_tokens + cache_read + cache_write

          bucket = model_usage.setdefault(
            model,
            {
              "inputTokens": 0,
              "outputTokens": 0,
              "cacheReadInputTokens": 0,
              "cacheCreationInputTokens": 0,
            },
          )
          bucket["inputTokens"] += input_tokens
          bucket["outputTokens"] += output_tokens
          bucket["cacheReadInputTokens"] += cache_read
          bucket["cacheCreationInputTokens"] += cache_write

          if day in recent:
            recent[day]["messageCount"] += total_turn_tokens

          if day == today:
            today_sessions.add(session_id)
            today_total_tokens += total_turn_tokens
            today_tokens_by_model[model] = today_tokens_by_model.get(model, 0) + total_turn_tokens
      except Exception:
        pass

      conn.close()
    except Exception:
      continue

  # Fallback to transcripts if no DBs were read or 0 prompts
  if total_prompts == 0:
    for transcript_path in base_dir.glob("brain/*/.system_generated/logs/transcript.jsonl"):
      session_id = transcript_path.parent.parent.parent.name
      total_sessions.add(session_id)
      try:
        with transcript_path.open("r", encoding="utf-8", errors="replace") as f:
          for line in f:
            line = line.strip()
            if not line:
              continue
            entry = json.loads(line)
            stype = entry.get("type")
            created_at = entry.get("created_at") or ""
            day = created_at[:10] if len(created_at) >= 10 else today
            if stype == "USER_INPUT":
              total_prompts += 1
              active_days.add(day)
              if day == today:
                today_prompts += 1
                today_sessions.add(session_id)
      except Exception:
        pass

  stats = {
    "todayPrompts": today_prompts,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_total_tokens,
    "todayTokensByModel": today_tokens_by_model,
    "recentDays": [recent[d] for d in recent_dates],
    "totalPrompts": total_prompts,
    "totalSessions": len(total_sessions),
    "activeDays": len(active_days),
    "activeDates": sorted(active_days),
    "modelUsage": model_usage,
  }

  runtime = {
    "latest_model": latest_model,
    "quota_info": latest_quota_info,
  }

  return stats, runtime


def read_fresh_json(path: Path, max_age_seconds: float) -> dict[str, Any] | None:
  if max_age_seconds <= 0 or not path.exists():
    return None
  try:
    age = time.time() - path.stat().st_mtime
    if 0 <= age <= max_age_seconds:
      return json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return None
  return None


def write_json(path: Path, payload: dict[str, Any]) -> None:
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":")) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def cached_stats(max_age: float) -> tuple[dict[str, Any], dict[str, Any]]:
  base = gemini_dir()
  digest = hashlib.sha1(str(base).encode("utf-8")).hexdigest()[:16]
  root = cache_root()
  cache_file = root / f"antigravity-scan-{digest}.json"
  lock_file = root / f"antigravity-scan-{digest}.lock"

  if max_age > 0:
    cached = read_fresh_json(cache_file, max_age)
    if cached and cached.get("schemaVersion") == 1 and cached.get("scanDate") == local_date_string():
      stats = cached.get("stats")
      runtime = cached.get("runtime")
      if isinstance(stats, dict) and isinstance(runtime, dict):
        return stats, runtime

  try:
    with lock_file.open("w") as lock:
      fcntl.flock(lock, fcntl.LOCK_EX)
      if max_age > 0:
        cached = read_fresh_json(cache_file, max_age)
        if cached and cached.get("schemaVersion") == 1 and cached.get("scanDate") == local_date_string():
          stats = cached.get("stats")
          runtime = cached.get("runtime")
          if isinstance(stats, dict) and isinstance(runtime, dict):
            return stats, runtime
      stats, runtime = scan_sqlite_conversations(base)
      write_json(cache_file, {"schemaVersion": 1, "scanDate": local_date_string(), "stats": stats, "runtime": runtime})
      return stats, runtime
  except Exception:
    return scan_sqlite_conversations(base)


def format_tokens(n: float | int) -> str:
  n = float(n)
  if n >= 1e9:
    return f"{n / 1e9:.1f}B"
  if n >= 1e6:
    return f"{n / 1e6:.1f}M"
  if n >= 1e3:
    return f"{n / 1e3:.1f}k"
  return str(int(n))


def build_limits(runtime: dict[str, Any], stats: dict[str, Any]) -> list[dict[str, Any]]:
  limits = []

  # Rolling 7-day average daily quota / pace
  recent_days = stats.get("recentDays", [])
  today_str = local_date_string()
  past_active = [
    d["messageCount"]
    for d in recent_days
    if isinstance(d, dict) and d.get("date") != today_str and (d.get("messageCount") or 0) > 0
  ]

  today_tokens = stats.get("todayTotalTokens", 0)

  if past_active:
    avg_tokens = sum(past_active) / len(past_active)
  elif today_tokens > 0:
    avg_tokens = float(today_tokens)
  else:
    avg_tokens = 100_000_000.0

  pct = min(1.0, float(today_tokens) / float(avg_tokens)) if avg_tokens > 0 else 0.0

  now = dt.datetime.now().astimezone()
  midnight = (now.replace(hour=0, minute=0, second=0, microsecond=0) + dt.timedelta(days=1)).isoformat()

  pct_disp = round((float(today_tokens) / float(avg_tokens) * 100), 1) if avg_tokens > 0 else 0.0
  limits.append({
    "label": f"Daily Pace (7d avg {format_tokens(avg_tokens)})",
    "title": "Daily Pace",
    "percent": round(pct, 4),
    "resetsAt": midnight,
    "detail": f"{format_tokens(today_tokens)} / {format_tokens(avg_tokens)} tokens ({pct_disp}% of 7d avg)",
  })

  return limits


def main() -> int:
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true", help="rescan conversations and ignore cache")
  parser.add_argument("--limits-only", action="store_true", help="reuse recent scans")
  parser.add_argument("--cache-seconds", type=float, default=SCAN_REUSE_SECONDS)
  args = parser.parse_args()

  max_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else args.cache_seconds)
  stats, runtime = cached_stats(max_age)
  limits = build_limits(runtime, stats)

  model_label = runtime.get("latest_model", "Gemini 3.7 Flash")
  tier_label = model_label.replace("gemini-", "Gemini ").replace("-", " ").title()

  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "tierLabel": tier_label,
    "ready": stats["totalPrompts"] > 0 or len(limits) > 0,
    "hasLocalStats": True,
    "usageStatusText": "",
    "authHelpText": AUTH_HELP,
    "limits": limits,
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
  }
  record.update(stats)

  print(json.dumps(record, separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
